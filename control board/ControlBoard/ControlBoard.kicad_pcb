	(footprint "ControlBoard:Texas_RPW0010A_VQFN-HR-10_2x2mm_P0.475mm"
		(layer "F.Cu")
		(uuid "e0b5c796-1ac6-4e48-a3fd-af719a275fb0")
		(at 167.132 101.85 90)
		(descr "TI RPW0010A VQFN-HR-10 2x2mm (TPS25947). Built from datasheet SLVSFC9C p.72-74 land pattern + stencil; corner pads 1/4/7/10 are L-shaped custom pads; bars 5/6 use split paste windows (89%), corner pads 93% paste. Cross-checked vs TI Ultra Librarian export")
		(tags "TPS25947 VQFN-HR RPW0010A")
		(property "Reference" "U3"
			(at 0 -2.2 90)
			(layer "F.SilkS")
